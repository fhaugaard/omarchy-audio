#!/usr/bin/env bash
# omarchy:summary=Audio routing manager for simultaneous output and stream routing
# omarchy:group=audio

set -euo pipefail

cmd="${1:-help}"
shift || true

function usage() {
  cat <<EOF
Usage: omarchy-audio-routing <command> [args...]

Commands:
  list-cards                                    List sound cards and their active profiles as JSON
  list-streams-and-links                        List active streams and their target sinks as JSON
  route-stream-to-sink <stream> <sink> [name]   Move application stream cleanly to target sink
  toggle-simultaneous [target_sink]             Toggle simultaneous output across physical sinks
  set-simultaneous-sinks <sink1> <sink2> ...    Set custom subset of outputs for simultaneous playback
  get-simultaneous-sinks                        Get array of currently active simultaneous slave sinks as JSON
  set-sink-port <sink> <port>                   Switch sink port (e.g. Line Out / Headphones)
  reset-all                                     Reset all audio streams and profiles to safe defaults
EOF
}

function unmute_alsa_card() {
  local target_card="${1:-}"
  if [[ -n "$target_card" ]]; then
    for ctrl in Master Front Headphone Surround Center LFE Line; do
      amixer -c "$target_card" set "$ctrl" unmute 100% 2>/dev/null || true
    done
    return
  fi

  # Dynamically discover all ALSA sound card indices
  while read -r card_num; do
    if [[ -n "$card_num" ]]; then
      for ctrl in Master Front Headphone Surround Center LFE Line; do
        amixer -c "$card_num" set "$ctrl" unmute 100% 2>/dev/null || true
      done
    fi
  done < <(aplay -l 2>/dev/null | grep -E '^card [0-9]+:' | awk '{print $2}' | tr -d ':' | sort -u)
}

case "$cmd" in
  list-cards)
    python3 -c '
import subprocess, json, re

try:
    res = subprocess.run(["pactl", "--format=json", "list", "cards"], capture_output=True, text=True, check=True)
    cards_raw = json.loads(res.stdout)
except Exception:
    cards_raw = []

try:
    res_sinks = subprocess.run(["pactl", "--format=json", "list", "sinks"], capture_output=True, text=True)
    sinks_raw = json.loads(res_sinks.stdout)
except Exception:
    sinks_raw = []

is_simultaneous_active = False
simultaneous_slaves = []
try:
    res_mods = subprocess.run(["pactl", "--format=json", "list", "modules"], capture_output=True, text=True)
    mods = json.loads(res_mods.stdout)
    for m in mods:
        if m.get("name") == "module-combine-sink" and "omarchy_combined" in m.get("argument", ""):
            is_simultaneous_active = True
            arg = m.get("argument", "")
            match = re.search(r"slaves=([^\s]+)", arg)
            if match:
                simultaneous_slaves = [s.strip() for s in match.group(1).split(",") if s.strip()]
except Exception:
    pass

cards = []
for c in cards_raw:
    props = c.get("properties", {})
    profiles_raw = c.get("profiles", {})
    active = c.get("active_profile", "")
    card_name = c.get("name", "")
    card_idx_str = str(c.get("index"))
    card_bus = props.get("device.bus_path") or ""
    
    profiles = []
    has_pro = "pro-audio" in profiles_raw
    for pname, pdata in profiles_raw.items():
        profiles.append({
            "name": pname,
            "description": pdata.get("description", pname),
            "sinks": pdata.get("sinks", 0),
            "sources": pdata.get("sources", 0),
            "available": pdata.get("available", True),
            "priority": pdata.get("priority", 0)
        })

    card_desc = props.get("device.description") or props.get("device.product.name") or c.get("name")
    card_nick = props.get("device.nick") or props.get("alsa.card_name") or card_desc

    card_sinks = []
    for sk in sinks_raw:
        sk_name = sk.get("name", "")
        sk_props = sk.get("properties", {})
        sk_card = str(sk_props.get("device.card") or sk_props.get("card.profile.device") or "")
        sk_dev = sk_props.get("device.name") or ""
        
        is_card_sink = (
            (sk_dev and sk_dev == card_name)
            or (sk_card and sk_card == card_idx_str)
            or (card_bus and card_bus in sk_name)
            or (card_name and card_name.replace("alsa_card.", "alsa_output.") in sk_name)
        )
        if is_card_sink and "omarchy_combined" not in sk_name:
            card_sinks.append({
                "name": sk_name,
                "description": sk.get("description", sk_name),
                "activePort": sk.get("active_port"),
                "ports": [p.get("name") for p in sk.get("ports", [])]
            })

    cards.append({
        "id": c.get("index"),
        "name": c.get("name"),
        "description": card_desc,
        "nick": card_nick,
        "icon": props.get("device.icon_name") or props.get("device.icon-name") or "audio-card",
        "activeProfile": active,
        "hasProAudio": has_pro,
        "isProAudio": active == "pro-audio",
        "profiles": profiles,
        "cardSinks": card_sinks,
        "isSimultaneous": is_simultaneous_active,
        "simultaneousSlaves": simultaneous_slaves
    })

print(json.dumps(cards, indent=2))
'
    ;;

  get-simultaneous-sinks)
    python3 -c '
import subprocess, json, re

slaves = []
try:
    res_mods = subprocess.run(["pactl", "--format=json", "list", "modules"], capture_output=True, text=True)
    mods = json.loads(res_mods.stdout) if res_mods.stdout else []
    for m in mods:
        if m.get("name") == "module-combine-sink" and "omarchy_combined" in m.get("argument", ""):
            arg = m.get("argument", "")
            match = re.search(r"slaves=([^\s]+)", arg)
            if match:
                slaves = [s.strip() for s in match.group(1).split(",") if s.strip()]
except Exception:
    pass

print(json.dumps(slaves))
'
    ;;

  set-simultaneous-sinks)
    python3 -c '
import subprocess, json, sys

raw_args = sys.argv[1:]
target_sinks = []
for a in raw_args:
    for s in a.split(","):
        clean = s.strip()
        if clean and clean not in target_sinks and "omarchy_combined" not in clean:
            target_sinks.append(clean)

res_mods = subprocess.run(["pactl", "list", "modules", "short"], capture_output=True, text=True)
comb_mods = []
for line in res_mods.stdout.splitlines():
    parts = line.split("\t")
    if len(parts) >= 2 and "module-combine-sink" in parts[1] and "omarchy_combined" in line:
        comb_mods.append(parts[0].strip())

res_sinks = subprocess.run(["pactl", "--format=json", "list", "sinks"], capture_output=True, text=True)
sinks_data = json.loads(res_sinks.stdout) if res_sinks.stdout else []
physical_sinks = [s.get("name") for s in sinks_data if "omarchy_combined" not in s.get("name", "")]

# Resolve sink names if indices or IDs were given
resolved_slaves = []
for target in target_sinks:
    if target in physical_sinks:
        resolved_slaves.append(target)
    else:
        for s in sinks_data:
            if str(s.get("index")) == target or str(s.get("properties", {}).get("object.id")) == target:
                name = s.get("name")
                if name and name in physical_sinks and name not in resolved_slaves:
                    resolved_slaves.append(name)
                    break

# Always unload existing combined sink first
for m in comb_mods:
    subprocess.run(["pactl", "unload-module", str(m)])

if len(resolved_slaves) >= 2:
    slaves_str = ",".join(resolved_slaves)
    print(f"Enabling custom simultaneous playback across: {slaves_str}")
    subprocess.run(["pactl", "load-module", "module-combine-sink", "sink_name=omarchy_combined", f"slaves={slaves_str}", "sink_properties=device.description=Simultaneous\\ Output"])
    subprocess.run(["pactl", "set-default-sink", "omarchy_combined"])
    res_inputs = subprocess.run(["pactl", "--format=json", "list", "sink-inputs"], capture_output=True, text=True)
    try:
        for inp in json.loads(res_inputs.stdout):
            props = inp.get("properties", {})
            if props.get("module-combine-sink.sink") or "combine" in str(props.get("node.name", "")).lower():
                continue
            subprocess.run(["pactl", "move-sink-input", str(inp.get("index")), "omarchy_combined"], capture_output=True)
    except Exception:
        pass
elif len(resolved_slaves) == 1:
    target = resolved_slaves[0]
    print(f"Setting single default output: {target}")
    subprocess.run(["pactl", "set-default-sink", target])
    subprocess.run(["pactl", "set-sink-mute", target, "0"])
    res_inputs = subprocess.run(["pactl", "--format=json", "list", "sink-inputs"], capture_output=True, text=True)
    try:
        for inp in json.loads(res_inputs.stdout):
            props = inp.get("properties", {})
            if props.get("module-combine-sink.sink") or "combine" in str(props.get("node.name", "")).lower():
                continue
            subprocess.run(["pactl", "move-sink-input", str(inp.get("index")), target], capture_output=True)
    except Exception:
        pass
' "$@"
    ;;

  list-streams-and-links)
    python3 -c '
import subprocess, json

try:
    res_inputs = subprocess.run(["pactl", "--format=json", "list", "sink-inputs"], capture_output=True, text=True)
    inputs = json.loads(res_inputs.stdout) if res_inputs.stdout else []
except Exception:
    inputs = []

try:
    res_sinks = subprocess.run(["pactl", "--format=json", "list", "sinks"], capture_output=True, text=True)
    sinks_dict = {s.get("index"): s.get("name") for s in json.loads(res_sinks.stdout)} if res_sinks.stdout else {}
except Exception:
    sinks_dict = {}

stream_links = {}
for inp in inputs:
    props = inp.get("properties", {})
    sink_idx = inp.get("sink")
    sink_name = sinks_dict.get(sink_idx, "")
    
    app = props.get("application.name") or ""
    node_name = props.get("node.name") or ""
    media = props.get("media.name") or ""
    inp_id = str(inp.get("index"))
    obj_id = str(props.get("object.id") or "")
    
    for key in [app, node_name, media, inp_id, obj_id]:
        if key:
            if key not in stream_links:
                stream_links[key] = []
            if sink_name and sink_name not in stream_links[key]:
                stream_links[key].append(sink_name)

print(json.dumps(stream_links, indent=2))
'
    ;;

  route-stream-to-sink)
    stream_arg="${1:-}"
    sink_arg="${2:-}"
    stream_name="${3:-}"
    sink_id="${4:-}"
    
    if [[ -z "$stream_arg" || -z "$sink_arg" ]]; then
      echo "Error: stream and target sink required" >&2
      exit 1
    fi
    
    python3 -c '
import subprocess, json, sys

stream_arg = sys.argv[1]
sink_arg = sys.argv[2]
stream_name = sys.argv[3] if len(sys.argv) > 3 else ""
sink_id = sys.argv[4] if len(sys.argv) > 4 else ""

try:
    res_inputs = subprocess.run(["pactl", "--format=json", "list", "sink-inputs"], capture_output=True, text=True)
    inputs = json.loads(res_inputs.stdout) if res_inputs.stdout else []
except Exception:
    inputs = []

try:
    res_sinks = subprocess.run(["pactl", "--format=json", "list", "sinks"], capture_output=True, text=True)
    sinks = json.loads(res_sinks.stdout) if res_sinks.stdout else []
except Exception:
    sinks = []

sink_names = [s.get("name") for s in sinks]
resolved_sink = sink_arg
if sink_arg not in sink_names:
    for s in sinks:
        if str(s.get("index")) == sink_arg or str(s.get("properties", {}).get("object.id")) == sink_id or str(s.get("properties", {}).get("node.id")) == sink_id or str(s.get("name", "")) == sink_arg:
            resolved_sink = s.get("name")
            break

for inp in inputs:
    props = inp.get("properties", {})
    idx = str(inp.get("index"))
    obj_id = str(props.get("object.id") or "")
    serial = str(props.get("object.serial") or "")
    app = (props.get("application.name") or "").lower()
    node = (props.get("node.name") or "").lower()
    media = (props.get("media.name") or "").lower()

    is_match = False
    if stream_arg and (stream_arg == idx or stream_arg == obj_id or stream_arg == serial):
        is_match = True
    elif stream_name and (stream_name.lower() in [app, node, media] or app in stream_name.lower()):
        is_match = True

    if is_match:
        subprocess.run(["pactl", "move-sink-input", idx, resolved_sink], capture_output=True)
' "$stream_arg" "$sink_arg" "$stream_name" "$sink_id"
    ;;

  toggle-simultaneous)
    target_sink_arg="${1:-}"
    python3 -c '
import subprocess, json, sys

target_sink_arg = sys.argv[1] if len(sys.argv) > 1 else ""

res_mods = subprocess.run(["pactl", "list", "modules", "short"], capture_output=True, text=True)
comb_mods = []
for line in res_mods.stdout.splitlines():
    parts = line.split("\t")
    if len(parts) >= 2 and "module-combine-sink" in parts[1] and "omarchy_combined" in line:
        comb_mods.append(parts[0].strip())

if comb_mods:
    print("Disabling simultaneous playback...")
    res_sinks = subprocess.run(["pactl", "--format=json", "list", "sinks"], capture_output=True, text=True)
    sinks_data = json.loads(res_sinks.stdout) if res_sinks.stdout else []
    physical_sinks = [s for s in sinks_data if "omarchy_combined" not in s.get("name", "")]

    sink_vols = {}
    for s in physical_sinks:
        v_pct = s.get("volume", {}).get("front-left", {}).get("value_percent")
        if v_pct:
            sink_vols[s.get("name")] = v_pct

    for m in comb_mods:
        subprocess.run(["pactl", "unload-module", str(m)])

    selected_sink = None
    if target_sink_arg:
        for s in physical_sinks:
            if s.get("name") == target_sink_arg or str(s.get("index")) == target_sink_arg:
                selected_sink = s
                break
    if not selected_sink:
        unmuted_sinks = [s for s in physical_sinks if not s.get("mute", False)]
        if unmuted_sinks:
            selected_sink = unmuted_sinks[0]
        elif physical_sinks:
            selected_sink = physical_sinks[0]

    if selected_sink:
        sink_name = selected_sink.get("name")
        subprocess.run(["pactl", "set-default-sink", sink_name])
        subprocess.run(["pactl", "set-sink-mute", sink_name, "0"])
        res_inputs = subprocess.run(["pactl", "--format=json", "list", "sink-inputs"], capture_output=True, text=True)
        try:
            for inp in json.loads(res_inputs.stdout):
                props = inp.get("properties", {})
                if props.get("module-combine-sink.sink") or "combine" in str(props.get("node.name", "")).lower():
                    continue
                subprocess.run(["pactl", "move-sink-input", str(inp.get("index")), sink_name], capture_output=True)
        except Exception:
            pass
else:
    print("Enabling simultaneous playback across all devices...")
    res_sinks = subprocess.run(["pactl", "--format=json", "list", "sinks"], capture_output=True, text=True)
    sinks_data = json.loads(res_sinks.stdout) if res_sinks.stdout else []
    physical_sinks = [s.get("name") for s in sinks_data if "omarchy_combined" not in s.get("name", "")]

    if len(physical_sinks) >= 2:
        slaves = ",".join(physical_sinks)
        res = subprocess.run(["pactl", "load-module", "module-combine-sink", "sink_name=omarchy_combined", f"slaves={slaves}", "sink_properties=device.description=Simultaneous\\ Output\\ (All\\ Devices)"], capture_output=True, text=True)
        subprocess.run(["pactl", "set-default-sink", "omarchy_combined"])
        res_inputs = subprocess.run(["pactl", "--format=json", "list", "sink-inputs"], capture_output=True, text=True)
        try:
            for inp in json.loads(res_inputs.stdout):
                props = inp.get("properties", {})
                if props.get("module-combine-sink.sink") or "combine" in str(props.get("node.name", "")).lower():
                    continue
                subprocess.run(["pactl", "move-sink-input", str(inp.get("index")), "omarchy_combined"], capture_output=True)
        except Exception:
            pass
' "$target_sink_arg"
    ;;

  set-sink-port)
    sink_name="${1:-}"
    port_name="${2:-}"
    pactl set-sink-port "$sink_name" "$port_name"
    ;;

  reset-all)
    pactl unload-module $(pactl list modules short | grep module-combine-sink | awk '{print $1}') 2>/dev/null || true
    unmute_alsa_card
    pactl list sink-inputs short | awk '{print $1}' | while read id; do
      pactl set-sink-input-mute "$id" 0 2>/dev/null || true
    done
    echo "Reset complete: all devices, streams, and ALSA mixers restored to clean defaults."
    ;;

  help|*)
    usage
    ;;
esac
