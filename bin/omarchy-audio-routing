#!/usr/bin/env bash
# omarchy:summary=Audio routing manager for simultaneous output and stream routing
# omarchy:group=audio

set -euo pipefail

cmd="${1:-help}"
shift || true

function usage() {
  cat <<EOF
Usage: omarchy-audio-routing <command> [args...]

Commands:
  list-cards                                    List sound cards and their active profiles as JSON
  list-streams-and-links                        List active streams and their target sinks as JSON
  route-stream-to-sink <stream> <sink> [name]   Move application stream cleanly to target sink
  toggle-simultaneous [target_sink]             Toggle multi-output across physical sinks
  set-simultaneous-sinks <sink1> <sink2> ...    Set custom subset of outputs for multi-output playback
  get-simultaneous-sinks                        Get array of currently active multi-output target sinks as JSON
  set-sink-port <sink> <port>                   Switch sink port (e.g. Line Out / Headphones)
  reset-all                                     Reset all audio streams and profiles to safe defaults
EOF
}

function unmute_alsa_card() {
  local target_card="${1:-}"
  if [[ -n "$target_card" ]]; then
    for ctrl in Master Front Headphone Surround Center LFE Line; do
      amixer -c "$target_card" set "$ctrl" unmute 100% 2>/dev/null || true
    done
    return
  fi

  # Dynamically discover all ALSA sound card indices
  while read -r card_num; do
    if [[ -n "$card_num" ]]; then
      for ctrl in Master Front Headphone Surround Center LFE Line; do
        amixer -c "$card_num" set "$ctrl" unmute 100% 2>/dev/null || true
      done
    fi
  done < <(aplay -l 2>/dev/null | grep -E '^card [0-9]+:' | awk '{print $2}' | tr -d ':' | sort -u)
}

case "$cmd" in
  list-cards)
    python3 -c '
import subprocess, json, re

try:
    res = subprocess.run(["pactl", "--format=json", "list", "cards"], capture_output=True, text=True, check=True)
    cards_raw = json.loads(res.stdout)
except Exception:
    cards_raw = []

try:
    res_sinks = subprocess.run(["pactl", "--format=json", "list", "sinks"], capture_output=True, text=True)
    sinks_raw = json.loads(res_sinks.stdout)
except Exception:
    sinks_raw = []

is_simultaneous_active = False
multi_output_targets = []
combined_volume = 1.0
combined_muted = False
try:
    res_mods = subprocess.run(["pactl", "--format=json", "list", "modules"], capture_output=True, text=True)
    mods = json.loads(res_mods.stdout) if res_mods.stdout else []
    for m in mods:
        if m.get("name") == "module-combine-sink" and "omarchy_combined" in m.get("argument", ""):
            is_simultaneous_active = True
            arg = m.get("argument", "")
            # Note: 'slaves' is the literal module-combine-sink argument name in PulseAudio/PipeWire C API
            match = re.search(r"slaves=([^\s]+)", arg)
            if match:
                multi_output_targets = [s.strip() for s in match.group(1).split(",") if s.strip()]
except Exception:
    pass

for sk in sinks_raw:
    if "omarchy_combined" in sk.get("name", ""):
        v_obj = sk.get("volume", {}).get("front-left", {})
        if v_obj and "value" in v_obj:
            combined_volume = round(v_obj["value"] / 65536.0, 4)
        combined_muted = bool(sk.get("mute", False))
        break

cards = []
for c in cards_raw:
    props = c.get("properties", {})
    profiles_raw = c.get("profiles", {})
    active = c.get("active_profile", "")
    card_name = c.get("name", "")
    card_idx_str = str(c.get("index"))
    card_bus = props.get("device.bus_path") or ""
    
    profiles = []
    has_pro = "pro-audio" in profiles_raw
    for pname, pdata in profiles_raw.items():
        profiles.append({
            "name": pname,
            "description": pdata.get("description", pname),
            "sinks": pdata.get("sinks", 0),
            "sources": pdata.get("sources", 0),
            "available": pdata.get("available", True),
            "priority": pdata.get("priority", 0)
        })

    card_desc = props.get("device.description") or props.get("device.product.name") or c.get("name")
    card_nick = props.get("device.nick") or props.get("alsa.card_name") or card_desc

    card_sinks = []
    for sk in sinks_raw:
        sk_name = sk.get("name", "")
        sk_props = sk.get("properties", {})
        sk_card = str(sk_props.get("device.card") or sk_props.get("card.profile.device") or "")
        sk_dev = sk_props.get("device.name") or ""
        
        is_card_sink = (
            (sk_dev and sk_dev == card_name)
            or (sk_card and sk_card == card_idx_str)
            or (card_bus and card_bus in sk_name)
            or (card_name and card_name.replace("alsa_card.", "alsa_output.") in sk_name)
        )
        if is_card_sink and "omarchy_combined" not in sk_name:
            card_sinks.append({
                "name": sk_name,
                "description": sk.get("description", sk_name),
                "activePort": sk.get("active_port"),
                "ports": [p.get("name") for p in sk.get("ports", [])]
            })

    cards.append({
        "id": c.get("index"),
        "name": c.get("name"),
        "description": card_desc,
        "nick": card_nick,
        "icon": props.get("device.icon_name") or props.get("device.icon-name") or "audio-card",
        "activeProfile": active,
        "hasProAudio": has_pro,
        "isProAudio": active == "pro-audio",
        "profiles": profiles,
        "cardSinks": card_sinks,
        "isSimultaneous": is_simultaneous_active,
        "multiOutputTargets": multi_output_targets,
        "simultaneousSlaves": multi_output_targets,
        "combinedVolume": combined_volume,
        "combinedMuted": combined_muted
    })

print(json.dumps(cards, indent=2))
'
    ;;

  get-simultaneous-sinks)
    python3 -c '
import subprocess, json, re

targets = []
try:
    res_mods = subprocess.run(["pactl", "--format=json", "list", "modules"], capture_output=True, text=True)
    mods = json.loads(res_mods.stdout) if res_mods.stdout else []
    for m in mods:
        if m.get("name") == "module-combine-sink" and "omarchy_combined" in m.get("argument", ""):
            arg = m.get("argument", "")
            # Note: 'slaves' is the literal module-combine-sink argument name in PulseAudio/PipeWire C API
            match = re.search(r"slaves=([^\s]+)", arg)
            if match:
                targets = [s.strip() for s in match.group(1).split(",") if s.strip()]
except Exception:
    pass

print(json.dumps(targets))
'
    ;;

  set-simultaneous-sinks)
    python3 -c '
import subprocess, json, sys, time

raw_args = sys.argv[1:]
target_sinks = []
for a in raw_args:
    for s in a.split(","):
        clean = s.strip()
        if clean and clean not in target_sinks and "omarchy_combined" not in clean:
            target_sinks.append(clean)

def wait_for_sink_presence(sink_name, present=True, timeout=1.5):
    t0 = time.time()
    while time.time() - t0 < timeout:
        s_list = subprocess.run(["pactl", "list", "sinks", "short"], capture_output=True, text=True).stdout
        if (sink_name in s_list) == present:
            return True
        time.sleep(0.01)
    return False

def get_active_app_stream_ids():
    res = subprocess.run(["pactl", "--format=json", "list", "sink-inputs"], capture_output=True, text=True)
    inputs = json.loads(res.stdout) if res.stdout else []
    app_inputs = []
    for inp in inputs:
        props = inp.get("properties", {})
        name = str(props.get("node.name", "")).lower()
        media = str(props.get("media.name", "")).lower()
        if props.get("module-combine-sink.sink") or "combine" in name or "combine" in media:
            continue
        app_inputs.append(str(inp.get("index")))
    return app_inputs

def wait_for_streams_migration(stream_indices, target_sink_name, timeout=1.5):
    if not stream_indices:
        return True
    t0 = time.time()
    while time.time() - t0 < timeout:
        res_i = subprocess.run(["pactl", "--format=json", "list", "sink-inputs"], capture_output=True, text=True)
        inps = json.loads(res_i.stdout) if res_i.stdout else []
        res_s = subprocess.run(["pactl", "--format=json", "list", "sinks"], capture_output=True, text=True)
        sinks = json.loads(res_s.stdout) if res_s.stdout else []
        target_idx = None
        for s in sinks:
            if target_sink_name in s.get("name", ""):
                target_idx = s.get("index")
                break
        if target_idx is not None:
            all_moved = True
            for idx in stream_indices:
                matches = [i for i in inps if str(i.get("index")) == idx]
                if not matches or matches[0].get("sink") != target_idx:
                    all_moved = False
                    break
            if all_moved:
                return True
        time.sleep(0.01)
    return False

res_mods = subprocess.run(["pactl", "list", "modules", "short"], capture_output=True, text=True)
comb_mods = []
for line in res_mods.stdout.splitlines():
    parts = line.split("\t")
    if len(parts) >= 2 and "module-combine-sink" in parts[1] and "omarchy_combined" in line:
        comb_mods.append(parts[0].strip())

res_sinks = subprocess.run(["pactl", "--format=json", "list", "sinks"], capture_output=True, text=True)
sinks_data = json.loads(res_sinks.stdout) if res_sinks.stdout else []
physical_sinks = [s.get("name") for s in sinks_data if "omarchy_combined" not in s.get("name", "")]

# Capture existing combine sink volume & mute if active to preserve across reloads
prev_vol_pct = None
prev_muted = False
for s in sinks_data:
    if "omarchy_combined" in s.get("name", ""):
        v_obj = s.get("volume", {}).get("front-left", {})
        if v_obj and "value_percent" in v_obj:
            prev_vol_pct = v_obj["value_percent"]
        prev_muted = bool(s.get("mute", False))
        break

def is_preferred_sink(name):
    n = name.lower()
    return "pro-output" in n or "analog-stereo" in n or "speaker" in n or "hdmi" in n

preferred_sinks = [s for s in physical_sinks if is_preferred_sink(s) and "direct" not in s.lower()]
safe_physical = preferred_sinks[0] if preferred_sinks else (physical_sinks[0] if physical_sinks else None)

# Resolve requested target sinks
resolved_targets = []
for target in target_sinks:
    if target in physical_sinks:
        resolved_targets.append(target)
    else:
        for s in sinks_data:
            if str(s.get("index")) == target or str(s.get("properties", {}).get("object.id")) == target:
                name = s.get("name")
                if name and name in physical_sinks and name not in resolved_targets:
                    resolved_targets.append(name)
                    break

# Fallback sink for safe handover
fallback_sink = resolved_targets[0] if resolved_targets else safe_physical

# 1. Seamless handover: Migrate active streams to fallback physical sink before dismantling old combine module
if comb_mods and fallback_sink:
    app_streams = get_active_app_stream_ids()
    if app_streams:
        subprocess.run(["pactl", "set-default-sink", fallback_sink], capture_output=True)
        for idx in app_streams:
            subprocess.run(["pactl", "move-sink-input", idx, fallback_sink], capture_output=True)
            subprocess.run(["pactl", "set-sink-input-mute", idx, "0"], capture_output=True)
        wait_for_streams_migration(app_streams, fallback_sink)

# 2. Unload old combine modules and wait for teardown to finish
for m in comb_mods:
    subprocess.run(["pactl", "unload-module", str(m)], capture_output=True)
if comb_mods:
    wait_for_sink_presence("omarchy_combined", present=False)

# 3. Provision new state
if len(resolved_targets) >= 2:
    targets_str = ",".join(resolved_targets)
    print(f"Enabling custom multi-output playback across: {targets_str}")
    # Wake up all target sinks to avoid suspend/sleep latency (e.g. USB DACs, Bluetooth)
    for target in resolved_targets:
        subprocess.run(["pactl", "suspend-sink", target, "0"], capture_output=True)

    # Note: 'slaves=' is the literal module argument name in PulseAudio/PipeWire module-combine-sink C API
    subprocess.run(["pactl", "load-module", "module-combine-sink", "sink_name=omarchy_combined", f"slaves={targets_str}", "sink_properties=device.description=Multi-Output"], capture_output=True)
    wait_for_sink_presence("omarchy_combined", present=True)
    subprocess.run(["pactl", "suspend-sink", "omarchy_combined", "0"], capture_output=True)
    subprocess.run(["pactl", "set-default-sink", "omarchy_combined"], capture_output=True)
    
    if prev_vol_pct:
        subprocess.run(["pactl", "set-sink-volume", "omarchy_combined", prev_vol_pct], capture_output=True)
        subprocess.run(["pactl", "set-sink-mute", "omarchy_combined", "1" if prev_muted else "0"], capture_output=True)
    
    for target in resolved_targets:
        subprocess.run(["pactl", "set-sink-mute", target, "0"], capture_output=True)
        
    app_streams = get_active_app_stream_ids()
    if app_streams:
        for idx in app_streams:
            subprocess.run(["pactl", "move-sink-input", idx, "omarchy_combined"], capture_output=True)
            subprocess.run(["pactl", "set-sink-input-mute", idx, "0"], capture_output=True)
        wait_for_streams_migration(app_streams, "omarchy_combined")
else:
    target = resolved_targets[0] if resolved_targets else safe_physical
    if target:
        print(f"Setting single default output: {target}")
        subprocess.run(["pactl", "suspend-sink", target, "0"], capture_output=True)
        subprocess.run(["pactl", "set-default-sink", target], capture_output=True)
        subprocess.run(["pactl", "set-sink-mute", target, "0"], capture_output=True)

        # Restore unattenuated physical volume if flat-volumes scaled down the sink
        target_s_info = next((s for s in sinks_data if s.get("name") == target), None)
        target_vol_val = 0
        if target_s_info:
            target_vol_val = target_s_info.get("volume", {}).get("front-left", {}).get("value", 0)
        if target_vol_val == 0 and prev_vol_pct:
            subprocess.run(["pactl", "set-sink-volume", target, prev_vol_pct], capture_output=True)
        elif target_vol_val == 0:
            subprocess.run(["pactl", "set-sink-volume", target, "100%"], capture_output=True)

        app_streams = get_active_app_stream_ids()
        if app_streams:
            for idx in app_streams:
                subprocess.run(["pactl", "move-sink-input", idx, target], capture_output=True)
                subprocess.run(["pactl", "set-sink-input-mute", idx, "0"], capture_output=True)
            wait_for_streams_migration(app_streams, target)
' "$@"
    ;;

  list-streams-and-links)
    python3 -c '
import subprocess, json

try:
    res_inputs = subprocess.run(["pactl", "--format=json", "list", "sink-inputs"], capture_output=True, text=True)
    inputs = json.loads(res_inputs.stdout) if res_inputs.stdout else []
except Exception:
    inputs = []

try:
    res_sinks = subprocess.run(["pactl", "--format=json", "list", "sinks"], capture_output=True, text=True)
    sinks_dict = {s.get("index"): s.get("name") for s in json.loads(res_sinks.stdout)} if res_sinks.stdout else {}
except Exception:
    sinks_dict = {}

stream_links = {}
for inp in inputs:
    props = inp.get("properties", {})
    sink_idx = inp.get("sink")
    sink_name = sinks_dict.get(sink_idx, "")
    
    app = props.get("application.name") or ""
    node_name = props.get("node.name") or ""
    media = props.get("media.name") or ""
    inp_id = str(inp.get("index"))
    obj_id = str(props.get("object.id") or "")
    
    for key in [app, node_name, media, inp_id, obj_id]:
        if key:
            if key not in stream_links:
                stream_links[key] = []
            if sink_name and sink_name not in stream_links[key]:
                stream_links[key].append(sink_name)

print(json.dumps(stream_links, indent=2))
'
    ;;

  route-stream-to-sink)
    stream_arg="${1:-}"
    sink_arg="${2:-}"
    stream_name="${3:-}"
    sink_id="${4:-}"
    
    if [[ -z "$stream_arg" || -z "$sink_arg" ]]; then
      echo "Error: stream and target sink required" >&2
      exit 1
    fi
    
    python3 -c '
import subprocess, json, sys

stream_arg = sys.argv[1]
sink_arg = sys.argv[2]
stream_name = sys.argv[3] if len(sys.argv) > 3 else ""
sink_id = sys.argv[4] if len(sys.argv) > 4 else ""

try:
    res_inputs = subprocess.run(["pactl", "--format=json", "list", "sink-inputs"], capture_output=True, text=True)
    inputs = json.loads(res_inputs.stdout) if res_inputs.stdout else []
except Exception:
    inputs = []

try:
    res_sinks = subprocess.run(["pactl", "--format=json", "list", "sinks"], capture_output=True, text=True)
    sinks = json.loads(res_sinks.stdout) if res_sinks.stdout else []
except Exception:
    sinks = []

sink_names = [s.get("name") for s in sinks]
resolved_sink = sink_arg
if sink_arg not in sink_names:
    for s in sinks:
        if str(s.get("index")) == sink_arg or str(s.get("properties", {}).get("object.id")) == sink_id or str(s.get("properties", {}).get("node.id")) == sink_id or str(s.get("name", "")) == sink_arg:
            resolved_sink = s.get("name")
            break

for inp in inputs:
    props = inp.get("properties", {})
    idx = str(inp.get("index"))
    obj_id = str(props.get("object.id") or "")
    serial = str(props.get("object.serial") or "")
    app = (props.get("application.name") or "").lower()
    node = (props.get("node.name") or "").lower()
    media = (props.get("media.name") or "").lower()

    is_match = False
    if stream_arg and (stream_arg == idx or stream_arg == obj_id or stream_arg == serial):
        is_match = True
    elif stream_name and (stream_name.lower() in [app, node, media] or app in stream_name.lower()):
        is_match = True

    if is_match:
        subprocess.run(["pactl", "move-sink-input", idx, resolved_sink], capture_output=True)
' "$stream_arg" "$sink_arg" "$stream_name" "$sink_id"
    ;;

  toggle-simultaneous)
    target_sink_arg="${1:-}"
    python3 -c '
import subprocess, json, sys, time

target_sink_arg = sys.argv[1] if len(sys.argv) > 1 else ""

def wait_for_sink_presence(sink_name, present=True, timeout=1.5):
    t0 = time.time()
    while time.time() - t0 < timeout:
        s_list = subprocess.run(["pactl", "list", "sinks", "short"], capture_output=True, text=True).stdout
        if (sink_name in s_list) == present:
            return True
        time.sleep(0.01)
    return False

def get_active_app_stream_ids():
    res = subprocess.run(["pactl", "--format=json", "list", "sink-inputs"], capture_output=True, text=True)
    inputs = json.loads(res.stdout) if res.stdout else []
    app_inputs = []
    for inp in inputs:
        props = inp.get("properties", {})
        name = str(props.get("node.name", "")).lower()
        media = str(props.get("media.name", "")).lower()
        if props.get("module-combine-sink.sink") or "combine" in name or "combine" in media:
            continue
        app_inputs.append(str(inp.get("index")))
    return app_inputs

def wait_for_streams_migration(stream_indices, target_sink_name, timeout=1.5):
    if not stream_indices:
        return True
    t0 = time.time()
    while time.time() - t0 < timeout:
        res_i = subprocess.run(["pactl", "--format=json", "list", "sink-inputs"], capture_output=True, text=True)
        inps = json.loads(res_i.stdout) if res_i.stdout else []
        res_s = subprocess.run(["pactl", "--format=json", "list", "sinks"], capture_output=True, text=True)
        sinks = json.loads(res_s.stdout) if res_s.stdout else []
        target_idx = None
        for s in sinks:
            if target_sink_name in s.get("name", ""):
                target_idx = s.get("index")
                break
        if target_idx is not None:
            all_moved = True
            for idx in stream_indices:
                matches = [i for i in inps if str(i.get("index")) == idx]
                if not matches or matches[0].get("sink") != target_idx:
                    all_moved = False
                    break
            if all_moved:
                return True
        time.sleep(0.01)
    return False

res_mods = subprocess.run(["pactl", "list", "modules", "short"], capture_output=True, text=True)
comb_mods = []
for line in res_mods.stdout.splitlines():
    parts = line.split("\t")
    if len(parts) >= 2 and "module-combine-sink" in parts[1] and "omarchy_combined" in line:
        comb_mods.append(parts[0].strip())

res_sinks = subprocess.run(["pactl", "--format=json", "list", "sinks"], capture_output=True, text=True)
sinks_data = json.loads(res_sinks.stdout) if res_sinks.stdout else []
physical_sinks = [s.get("name") for s in sinks_data if "omarchy_combined" not in s.get("name", "")]

def is_preferred_sink(name):
    n = name.lower()
    return "pro-output" in n or "analog-stereo" in n or "speaker" in n or "hdmi" in n

preferred_sinks = [s for s in physical_sinks if is_preferred_sink(s) and "direct" not in s.lower()]
safe_physical = preferred_sinks[0] if preferred_sinks else (physical_sinks[0] if physical_sinks else None)

if comb_mods:
    print("Disabling simultaneous playback...")
    target = target_sink_arg if (target_sink_arg and target_sink_arg in physical_sinks) else safe_physical
    
    app_streams = get_active_app_stream_ids()
    if app_streams and target:
        subprocess.run(["pactl", "set-default-sink", target], capture_output=True)
        for idx in app_streams:
            subprocess.run(["pactl", "move-sink-input", idx, target], capture_output=True)
            subprocess.run(["pactl", "set-sink-input-mute", idx, "0"], capture_output=True)
        wait_for_streams_migration(app_streams, target)
        
    for m in comb_mods:
        subprocess.run(["pactl", "unload-module", str(m)], capture_output=True)
    wait_for_sink_presence("omarchy_combined", present=False)
    
    if target:
        subprocess.run(["pactl", "suspend-sink", target, "0"], capture_output=True)
        subprocess.run(["pactl", "set-default-sink", target], capture_output=True)
        subprocess.run(["pactl", "set-sink-mute", target, "0"], capture_output=True)
else:
    print("Enabling simultaneous playback across all devices...")
    active_targets = preferred_sinks if len(preferred_sinks) >= 2 else physical_sinks
    if len(active_targets) >= 2:
        fallback = active_targets[0]
        app_streams = get_active_app_stream_ids()
        if app_streams:
            subprocess.run(["pactl", "set-default-sink", fallback], capture_output=True)
            for idx in app_streams:
                subprocess.run(["pactl", "move-sink-input", idx, fallback], capture_output=True)
                subprocess.run(["pactl", "set-sink-input-mute", idx, "0"], capture_output=True)
            wait_for_streams_migration(app_streams, fallback)
            
        targets_str = ",".join(active_targets)
        for s in active_targets:
            subprocess.run(["pactl", "suspend-sink", s, "0"], capture_output=True)

        # Note: 'slaves=' is the literal module argument name in PulseAudio/PipeWire module-combine-sink C API
        subprocess.run(["pactl", "load-module", "module-combine-sink", "sink_name=omarchy_combined", f"slaves={targets_str}", "sink_properties=device.description=Multi-Output\\ (All\\ Devices)"], capture_output=True)
        wait_for_sink_presence("omarchy_combined", present=True)
        subprocess.run(["pactl", "suspend-sink", "omarchy_combined", "0"], capture_output=True)
        subprocess.run(["pactl", "set-default-sink", "omarchy_combined"], capture_output=True)
        
        for s in active_targets:
            subprocess.run(["pactl", "set-sink-mute", s, "0"], capture_output=True)
            
        if app_streams:
            for idx in app_streams:
                subprocess.run(["pactl", "move-sink-input", idx, "omarchy_combined"], capture_output=True)
                subprocess.run(["pactl", "set-sink-input-mute", idx, "0"], capture_output=True)
            wait_for_streams_migration(app_streams, "omarchy_combined")
' "$target_sink_arg"
    ;;

  set-sink-port)
    sink_name="${1:-}"
    port_name="${2:-}"
    pactl set-sink-port "$sink_name" "$port_name"
    ;;

  reset-all)
    pactl unload-module $(pactl list modules short | grep module-combine-sink | awk '{print $1}') 2>/dev/null || true
    unmute_alsa_card
    pactl list sink-inputs short | awk '{print $1}' | while read id; do
      pactl set-sink-input-mute "$id" 0 2>/dev/null || true
    done
    echo "Reset complete: all devices, streams, and ALSA mixers restored to clean defaults."
    ;;

  help|*)
    usage
    ;;
esac
